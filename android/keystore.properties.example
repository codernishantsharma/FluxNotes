# Copy this file to keystore.properties and fill in your actual values
# Or set these as environment variables before building:
#   KEY_ALIAS, KEY_PASSWORD, STORE_FILE, STORE_PASSWORD

# The alias of the key in the keystore
KEY_ALIAS=my-key-alias

# Password for the key
KEY_PASSWORD=my-key-password

# Path to the keystore .jks or .keystore file (absolute or relative to android/)
STORE_FILE=../my-release-key.jks

# Password for the keystore
STORE_PASSWORD=my-keystore-password
